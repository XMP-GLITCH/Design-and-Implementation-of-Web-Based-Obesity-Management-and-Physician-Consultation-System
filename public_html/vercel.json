{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/about",
      "dest": "public/about.html"
    },
    {
      "src": "/glp1-education",
      "dest": "public/glp1-education.html"
    },
    {
      "src": "/products",
      "dest": "public/products.html"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}
